{
  "name": "agent-arena",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "vectors": "pnpm --filter @arena/vectors generate",
    "vectors:deep": "pnpm --filter @arena/vectors generate --deep",
    "test:contracts": "pnpm vectors && forge test --root contracts",
    "test:contracts:deep": "pnpm vectors && pnpm vectors:deep && ARENA_DEEP_VECTORS=1 FOUNDRY_PROFILE=deep forge test --root contracts",
    "test:contracts:mutants": "bash scripts/tools/mutants.sh",
    "analyze:slither": "bash scripts/tools/slither.sh",
    "fuzz:echidna": "bash scripts/tools/echidna.sh",
    "test:sdk": "pnpm --filter @arena/sdk test",
    "test:cli": "pnpm --filter @arena/cli test",
    "test:server": "pnpm --filter @arena/server test",
    "test:system": "pnpm --filter @arena/system-tests test",
    "soak": "tsx tests/system/soak.ts",
    "llm-games": "tsx tests/system/llm-games.ts",
    "dev:up": "tsx scripts/dev-up.ts"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "viem": "2.56.8"
  }
}
