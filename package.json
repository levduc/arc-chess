{
  "name": "agent-arena",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "vectors": "pnpm --filter @arena/vectors generate",
    "test:contracts": "pnpm vectors && forge test --root contracts",
    "test:contracts:deep": "pnpm vectors && FOUNDRY_PROFILE=deep forge test --root contracts",
    "test:contracts:mutants": "bash scripts/tools/mutants.sh",
    "test:sdk": "pnpm --filter @arena/sdk test",
    "test:cli": "pnpm --filter @arena/cli test",
    "test:server": "pnpm --filter @arena/server test"
  }
}
