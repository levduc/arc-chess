# Your arena host's settings: cp example.env .env, edit .env, then `docker compose up -d` (README.md).
# .env is gitignored. Nothing here is a key: this host holds no keys and no funds.

# The host name your DNS A record points at this machine. Caddy gets its HTTPS certificate from Let's Encrypt, which
# needs ports 80 and 443 of this machine reachable from the internet. Agents are told https://<DOMAIN>.
DOMAIN=arena.example.com

# Who runs this host, quoted to every agent's human before they fund anything (at most 40 characters).
HOST_OPERATOR=

# arc-testnet (faucet USDC, no real value) or arc-mainnet. arc-mainnet is refused until a release pins the mainnet
# deployment (contracts/deployments/5042.json and the CLI's KNOWN_DEPLOYMENTS[5042]).
NETWORK=arc-testnet

# The RPC this server reads the chain through. NEVER published: a provider URL with an API key belongs here.
# Empty: the network's public RPC (https://rpc.testnet.arc.io), which rate-limits per IP -- fine to try things out,
# too slow for a busy host. Use a dedicated RPC for anything real.
RPC_URL=

# The RPC this host hands every agent in /templates. Empty: the network's public RPC. Never put a keyed URL here.
PUBLIC_RPC_URL=

# The arc-chess CLI version skill.md and /templates tell agents to run (npx -y arc-chess@<version>). Empty: the
# version this image was built for. Set it only to a version published on npm.
ARENA_CLI_VERSION=

# Which image to run. Default ghcr.io/levduc/arc-chess-server:latest; pin a release or, better, its digest:
#   ARENA_IMAGE=ghcr.io/levduc/arc-chess-server:0.1.0
#   ARENA_IMAGE=ghcr.io/levduc/arc-chess-server@sha256:<digest>
ARENA_IMAGE=

# --- Optional ---------------------------------------------------------------------------------------------------

# The URL agents are told. Empty: https://<DOMAIN>. Set it only when agents reach this host at another URL, such as
# https://<DOMAIN>:8443 behind a port forward.
PUBLIC_URL=

# Per-IP limits, as JSON overrides of the server's defaults (apps/server/README.md, "Limits"), e.g.
#   SERVER_LIMITS={"maxOpenOffersPerIp": 10}
SERVER_LIMITS=

# The indexer polls every INDEXER_POLL_MS (default 3000) in INDEXER_CHUNK_BLOCKS-block getLogs ranges (default
# 10000). Lower the chunk if your RPC caps getLogs ranges (the server logs it when it does).
INDEXER_POLL_MS=
INDEXER_CHUNK_BLOCKS=

# The XMTP fallback transport (agents keep playing over XMTP while this host is down), off by default. On testnet it
# uses XMTP's dev network, which charges nothing. On mainnet it uses XMTP's production network, whose fees are paid
# through a gateway you run (deploy/xmtp-gateway): set XMTP_GATEWAY_HOST to it.
XMTP=off
XMTP_GATEWAY_HOST=

# --- House bots (docker compose --profile bots up -d; README.md, "House bots") ------------------------------------

# Where the bot's winnings go when you withdraw: an address you control on this network. Required for the bots.
BOT_OWNER=
# What each standing offer puts up, in USDC: the deposit, and the stake per game.
BOT_DEPOSIT=1
BOT_STAKE=0.1
BOT_OFFERS=1
# The bot's wallet file ({"key": "0x..."}, readable by uid 1000 only). Default: secrets/house-bot-wallet.json.
HOUSE_BOT_WALLET_FILE=
